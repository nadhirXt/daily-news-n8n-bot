# ============================================================
# Daily News Bot (daily-news-n8n-bot) — Configuration
# ============================================================
# Copier ce fichier en .env et renseigner vos valeurs personnelles.

# --- Instance n8n (Local ou Cloud) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Clé de chiffrement pour les credentials n8n (générer : openssl rand -hex 32)
N8N_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Authentification n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-secure-password

# Clé d'API n8n (pour déploiements et tests automatisés via scripts/)
N8N_API_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key

# --- Fuseau horaire ---
# Utilisé par le Schedule Trigger et le formatage des dates.
# Exemples : Europe/Paris, Africa/Algiers, America/New_York
GENERIC_TIMEZONE=Africa/Algiers

# --- Google Gemini AI ---
# Clé API gratuite obtenue sur Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-google-gemini-api-key

# --- Telegram Bot ---
# Token Bot obtenu auprès de @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKlmnoPQRstuvWXYZ

# ID de votre compte personnel ou d'un canal Telegram pour les alertes éditoriales
# Pour trouver votre ID personnel : écrivez à @userinfobot sur Telegram
TELEGRAM_ADMIN_CHAT_ID=your-telegram-chat-id

# ID du canal ou groupe cible (optionnel si utilisation en bot direct privé)
TELEGRAM_CHANNEL_CHAT_ID=your-channel-or-group-id
